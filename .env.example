# Generation is optional. Without a key the app runs retrieval-only, which is
# a supported state, not a broken one.
CFR_LLM_PROVIDER=gemini
GEMINI_API_KEY=
CFR_GEMINI_MODEL=gemini-flash-lite-latest

# CFR_LLM_PROVIDER=groq
# GROQ_API_KEY=

# Hard ceiling on generation calls per UTC day.
CFR_DAILY_BUDGET=500

# Set this from the output of `cfr calibrate`, not by guessing.
CFR_ABSTAIN_THRESHOLD=0.20
